<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_salary_increment" model="ir.ui.view">
        <field name="name">hr.employee.form.salary.increment</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_salary_increments" type="object"
                        class="oe_stat_button" icon="fa-line-chart"
                        groups="hr_payroll.group_hr_payroll_user">
                    <field name="salary_increment_count" widget="statinfo" string="Increments"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
