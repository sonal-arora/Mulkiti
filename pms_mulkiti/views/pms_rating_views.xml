<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pms_rating_view_form" model="ir.ui.view">
        <field name="name">pms.rating.form</field>
        <field name="model">pms.rating</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pms_rating_view_list" model="ir.ui.view">
        <field name="name">pms.rating.list</field>
        <field name="model">pms.rating</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_pms_rating" model="ir.actions.act_window">
        <field name="name">Rating Master</field>
        <field name="res_model">pms.rating</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
