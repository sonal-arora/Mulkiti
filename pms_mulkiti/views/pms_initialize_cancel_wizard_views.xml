<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pms_initialize_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">pms.initialize.cancel.wizard.form</field>
        <field name="model">pms.initialize.cancel.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="initialize_id" invisible="1"/>
                <group>
                    <field name="cancel_reason"
                           placeholder="Enter reason for cancellation..."
                           nolabel="1"
                           widget="text"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Confirm Cancel"
                            type="object"
                            class="btn-danger"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
