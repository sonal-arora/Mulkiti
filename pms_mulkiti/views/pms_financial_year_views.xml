<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pms_financial_year_view_form" model="ir.ui.view">
        <field name="name">pms.financial.year.form</field>
        <field name="model">pms.financial.year</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. 2025-26"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pms_financial_year_view_list" model="ir.ui.view">
        <field name="name">pms.financial.year.list</field>
        <field name="model">pms.financial.year</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_pms_financial_year" model="ir.actions.act_window">
        <field name="name">Financial Years</field>
        <field name="res_model">pms.financial.year</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
