<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pms_kra_view_form" model="ir.ui.view">
        <field name="name">pms.kra.form</field>
        <field name="model">pms.kra</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="KRA Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="financial_year_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Job Responsibilities &amp; Deliverables" name="kra_lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="job_responsibility" string="Job Responsibility / KRA"/>
                                    <field name="deliverable"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pms_kra_view_list" model="ir.ui.view">
        <field name="name">pms.kra.list</field>
        <field name="model">pms.kra</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="job_id"/>
                <field name="financial_year_id"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="pms_kra_view_search" model="ir.ui.view">
        <field name="name">pms.kra.search</field>
        <field name="model">pms.kra</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="job_id"/>
                <field name="financial_year_id"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Job Position" name="group_job" context="{'group_by':'job_id'}"/>
                    <filter string="Financial Year" name="group_fy" context="{'group_by':'financial_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pms_kra" model="ir.actions.act_window">
        <field name="name">KRA Master</field>
        <field name="res_model">pms.kra</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
