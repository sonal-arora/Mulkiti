<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_pms_appraisal">
    <t t-set="has_second_approver" t-value="bool(o.second_manager_id)"/>
    <t t-set="company" t-value="res_company"/>
    <div class="page o_pms_report">
        <style>
            /* NOTE: do not add a page-break-inside:avoid rule on table rows
               here. On the server's unpatched-Qt wkhtmltopdf build it causes
               rows near a page boundary to render twice in full (once cut
               off, once duplicated on the next page) instead of just moving
               cleanly to the next page. Left as default pagination instead. */

            /* Classic full-grid business-document look, matching the office
               Word template: solid black borders on every cell, a gold band
               for section titles and info-table labels. */
            .o_pms_report { font-size: 12px; color: #000000; line-height: 1.4; }
            .o_pms_report table.o_pms_grid {
                width: 100%;
                border-collapse: collapse;
            }
            .o_pms_report table.o_pms_grid th,
            .o_pms_report table.o_pms_grid td {
                border: 1px solid #000000;
                padding: 5px 8px;
                vertical-align: top;
            }
            .o_pms_report table.o_pms_grid th {
                background-color: #ffffff;
                font-weight: bold;
            }
            .o_pms_report .o_pms_info_label {
                background-color: #f6cb6d;
                font-weight: bold;
                text-transform: uppercase;
                width: 28%;
            }
            .o_pms_report h4.o_pms_section {
                background-color: #f6cb6d;
                font-weight: bold;
                text-transform: uppercase;
                font-size: 13px;
                padding: 6px 10px;
                margin: 20px 0 0 0;
                border: 1px solid #000000;
            }
            .o_pms_report .col-kra { width: 13%; }
            .o_pms_report .col-deliverable { width: 29%; }
            .o_pms_report .col-rating { width: 8%; }
            .o_pms_report .col-comments { width: 15%; }
        </style>
        <!-- Logo (left) + report title (center), pinned to the top of every
             printed page. Rendered as part of the normal page content (not
             via web.external_layout, which needs wkhtmltopdf to run JS for
             its header/footer, and that's broken on unpatched-Qt builds such
             as 0.12.6, which is what's installed on the live server and
             can't be changed there). A fixed-position element in the body
             repeats on every page without needing that JS step. -->
        <div style="position: fixed; top: 0; left: 0; right: 0; height: 100px;">
            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                 style="position: absolute; left: 0; top: 0; max-height:100px;"/>
            <h2 style="text-align: center; margin: 0; padding-top: 35px; text-transform: uppercase;">Employee Performance Review</h2>
        </div>
        <div style="padding-top: 115px;">
            <h4 class="text-center text-muted" style="font-weight: normal;">
                <span t-esc="o.name"/> · <span t-esc="o.financial_year_name"/>
            </h4>

            <table class="o_pms_grid mt-3">
                <tr><td class="o_pms_info_label">Employee</td><td><span t-field="o.employee_id.name"/></td></tr>
                <tr><td class="o_pms_info_label">Department</td><td><span t-field="o.department_id.name"/></td></tr>
                <tr><td class="o_pms_info_label">Job Position</td><td><span t-field="o.job_id.name"/></td></tr>
                <tr>
                    <td class="o_pms_info_label" t-esc="'1st Approver (Manager)' if has_second_approver else 'Approver'"/>
                    <td><span t-field="o.manager_id.name"/></td>
                </tr>
                <tr t-if="has_second_approver"><td class="o_pms_info_label">2nd Approver</td><td><span t-field="o.second_manager_id.name"/></td></tr>
                <tr><td class="o_pms_info_label">Status</td><td><span t-esc="dict(o._fields['state'].selection).get(o.state)"/></td></tr>
                <tr t-if="o.submit_date"><td class="o_pms_info_label">Submitted On</td><td><span t-field="o.submit_date"/></td></tr>
                <tr t-if="o.manager_review_date"><td class="o_pms_info_label">Manager Reviewed On</td><td><span t-field="o.manager_review_date"/></td></tr>
                <tr t-if="o.approval_date"><td class="o_pms_info_label">Approved On</td><td><span t-field="o.approval_date"/></td></tr>
            </table>

            <div t-if="o.project_list or o.team_list" class="mt-3">
                <p t-if="o.project_list">
                    <strong>List of Projects:</strong><br/>
                    <span t-field="o.project_list"/>
                </p>
                <p t-if="o.team_list">
                    <strong>List of Team:</strong><br/>
                    <span t-field="o.team_list"/>
                </p>
            </div>

            <!-- KRA & Self Assessment -->
            <h4 class="o_pms_section">KRA &amp; Self Assessment</h4>
            <table class="o_pms_grid" t-if="o.line_ids">
                <thead>
                    <tr>
                        <th class="col-kra">KRA / Responsibility</th>
                        <th class="col-deliverable">Key Deliverable / Target</th>
                        <th class="col-rating">Self Rating</th>
                        <th class="col-comments">Self Comments</th>
                        <th class="col-rating">Manager Rating</th>
                        <th class="col-comments">Manager Comments</th>
                        <th t-if="has_second_approver" class="col-rating">2nd Approver Rating</th>
                        <th t-if="has_second_approver" class="col-comments">2nd Approver Comments</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.line_ids" t-as="line">
                        <td><span t-field="line.job_responsibility"/></td>
                        <td><span t-field="line.deliverable"/></td>
                        <td><span t-field="line.self_rating_id.name"/></td>
                        <td><span t-field="line.self_comments"/></td>
                        <td><span t-field="line.manager_rating_id.name"/></td>
                        <td><span t-field="line.manager_comments"/></td>
                        <td t-if="has_second_approver"><span t-field="line.second_rating_id.name"/></td>
                        <td t-if="has_second_approver"><span t-field="line.second_comments"/></td>
                    </tr>
                </tbody>
            </table>

            <!-- Work Attitude & Behavior -->
            <div style="page-break-inside: avoid;">
                <h4 class="o_pms_section">Work Attitude &amp; Behavior</h4>
                <table class="o_pms_grid" t-if="o.attitude_line_ids">
                    <thead>
                        <tr>
                            <th class="col-kra">Name</th>
                            <th class="col-deliverable">Description</th>
                            <th class="col-rating">Self Rating</th>
                            <th class="col-comments">Self Comments</th>
                            <th class="col-rating">Manager Rating</th>
                            <th class="col-comments">Manager Comments</th>
                            <th t-if="has_second_approver" class="col-rating">2nd Approver Rating</th>
                            <th t-if="has_second_approver" class="col-comments">2nd Approver Comments</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.attitude_line_ids" t-as="line">
                            <td><span t-field="line.name"/></td>
                            <td><span t-field="line.description"/></td>
                            <td><span t-field="line.self_rating_id.name"/></td>
                            <td><span t-field="line.self_comments"/></td>
                            <td><span t-field="line.manager_rating_id.name"/></td>
                            <td><span t-field="line.manager_comments"/></td>
                            <td t-if="has_second_approver"><span t-field="line.second_rating_id.name"/></td>
                            <td t-if="has_second_approver"><span t-field="line.second_comments"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Mistakes, Complaints & Incidents -->
            <div style="page-break-inside: avoid;">
                <h4 class="o_pms_section">Mistakes, Complaints, and Incidents</h4>
                <table class="o_pms_grid" t-if="o.incident_line_ids">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Impact</th>
                            <th>Action Taken</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.incident_line_ids" t-as="line">
                            <td><span t-field="line.date"/></td>
                            <td><span t-field="line.description"/></td>
                            <td><span t-field="line.impact"/></td>
                            <td><span t-field="line.action_taken"/></td>
                        </tr>
                    </tbody>
                </table>
                <p t-if="o.additional_tasks_initiatives">
                    <strong>Additional Tasks and Initiatives:</strong><br/>
                    <span t-field="o.additional_tasks_initiatives"/>
                </p>
            </div>

            <!-- Training -->
            <div style="page-break-inside: avoid;">
                <h4 class="o_pms_section">Training</h4>
                <table class="o_pms_grid" t-if="o.training_line_ids">
                    <thead>
                        <tr>
                            <th>Training</th>
                            <th>I want to learn</th>
                            <th>I have complete Knowledge</th>
                            <th>I want to become trainer</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.training_line_ids" t-as="line">
                            <td><span t-field="line.training"/></td>
                            <td class="text-center"><span t-esc="'Yes' if line.want_to_learn else '-'"/></td>
                            <td class="text-center"><span t-esc="'Yes' if line.have_complete_knowledge else '-'"/></td>
                            <td class="text-center"><span t-esc="'Yes' if line.want_to_become_trainer else '-'"/></td>
                        </tr>
                    </tbody>
                </table>
                <p t-if="o.training_comments">
                    <strong>Training Comments:</strong><br/>
                    <span t-field="o.training_comments"/>
                </p>
            </div>

            <!-- Overall Comments -->
            <div style="page-break-inside: avoid;">
                <h4 class="o_pms_section">Overall Comments</h4>
                <p t-if="o.overall_self_comments">
                    <strong>Overall Self Comments:</strong><br/>
                    <span t-field="o.overall_self_comments"/>
                </p>
                <p t-if="o.overall_manager_comments">
                    <strong>Overall Manager Comments:</strong><br/>
                    <span t-field="o.overall_manager_comments"/>
                </p>
                <p t-if="o.overall_second_comments">
                    <strong>Overall 2nd Approver Comments:</strong><br/>
                    <span t-field="o.overall_second_comments"/>
                </p>
                <p t-if="o.general_comments">
                    <strong>Comments and Suggestions:</strong><br/>
                    <span t-field="o.general_comments"/>
                </p>
            </div>

            <!-- Sign-off -->
            <div style="page-break-inside: avoid;" class="mt-4">
                <h4 class="o_pms_section">Sign-off</h4>
                <table style="width:100%;">
                    <tr>
                        <td t-attf-style="width:#{'33%' if has_second_approver else '50%'}; text-align:center;">
                            <img t-if="o.employee_signature" t-att-src="image_data_uri(o.employee_signature)" style="max-height:80px;"/>
                            <div>Employee Signature</div>
                            <div t-if="o.employee_signature_date" class="text-muted">
                                <span t-field="o.employee_signature_date"/>
                            </div>
                        </td>
                        <td t-attf-style="width:#{'33%' if has_second_approver else '50%'}; text-align:center;">
                            <img t-if="o.manager_signature" t-att-src="image_data_uri(o.manager_signature)" style="max-height:80px;"/>
                            <div>Manager's Signature</div>
                            <div t-if="o.manager_signature_date" class="text-muted">
                                <span t-field="o.manager_signature_date"/>
                            </div>
                        </td>
                        <td t-if="has_second_approver" style="width:33%; text-align:center;">
                            <img t-if="o.owner_signature" t-att-src="image_data_uri(o.owner_signature)" style="max-height:80px;"/>
                            <div>Owner's Signature</div>
                            <div t-if="o.owner_signature_date" class="text-muted">
                                <span t-field="o.owner_signature_date"/>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</template>

<template id="report_pms_appraisal_document">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-set="o" t-value="o.sudo()"/>
            <t t-call="pms_mulkiti.report_pms_appraisal"/>
        </t>
    </t>
</template>
</odoo>
