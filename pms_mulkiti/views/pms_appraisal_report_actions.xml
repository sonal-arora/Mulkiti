<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Our own page format: the standard A4 format reserves about 52mm of
         empty top margin for wkhtmltopdf's header-html mechanism, which this
         report doesn't use (see report_pms_appraisal_document). A much
         smaller top margin is enough here since the logo is rendered inline
         at the top of the page content itself. -->
    <record id="paperformat_pms_appraisal" model="report.paperformat">
        <field name="name">Employee Performance Review</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_pms_appraisal" model="ir.actions.report">
        <field name="name">Employee Performance Review</field>
        <field name="model">pms.appraisal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pms_mulkiti.report_pms_appraisal_document</field>
        <field name="report_file">pms_mulkiti.report_pms_appraisal_document</field>
        <field name="print_report_name">'Employee Performance Review - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_pms_appraisal"/>
    </record>
</odoo>
