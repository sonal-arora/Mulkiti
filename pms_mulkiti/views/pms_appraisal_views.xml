<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════
         APPRAISAL FORM VIEW
    ══════════════════════════════════════════ -->
    <record id="pms_appraisal_view_form" model="ir.ui.view">
        <field name="name">pms.appraisal.form</field>
        <field name="model">pms.appraisal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Employee: Submit self-assessment -->
                    <button name="action_submit"
                            string="Submit Self-Assessment"
                            type="object"
                            class="oe_highlight"
                            invisible="not can_submit"/>

                    <!-- 1st Level Manager: Approve after reviewing -->
                    <button name="action_manager_approve"
                            string="Approve (1st Level)"
                            type="object"
                            class="oe_highlight"
                            invisible="not can_manager_approve"/>

                    <!-- 2nd Level Approver -->
                    <button name="action_second_approve"
                            string="Final Approve (2nd Level)"
                            type="object"
                            class="oe_highlight"
                            invisible="not can_second_approve"/>

                    <!-- Manager: Send back to draft with reason -->
                    <button name="action_reset_to_draft_with_reason"
                            string="Send Back to Draft"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'submitted' or not can_manager_approve"/>

                    <!-- Reject -->
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="not can_reject"/>

                    <!-- Head: Reset to Draft -->
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ['rejected','approved']"
                            groups="pms_mulkiti.group_pms_head"/>

                    <!-- Export Excel Report (only once approved) -->
                    <button name="action_export_xlsx_report"
                            string="Export Excel Report"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'approved'"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,manager_review,second_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"
                                   widget="many2one_avatar_employee"/>
                            <field name="department_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="financial_year_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="manager_id" readonly="1"/>
                            <field name="second_manager_id" readonly="1"/>
                            <field name="kra_id" readonly="1"/>
                            <field name="attitude_id" readonly="1"/>
                            <field name="training_id" readonly="1" invisible="not training_id"/>
                            <field name="submit_date" readonly="1"
                                   invisible="not submit_date"/>
                            <field name="manager_review_date" readonly="1"
                                   invisible="not manager_review_date"/>
                            <field name="approval_date" readonly="1"
                                   invisible="not approval_date"/>
                        </group>
                    </group>

                    <!-- Rating Legend: reference for filling ratings below -->
                    <group string="Rating Legend" name="rating_legend">
                        <field name="rating_legend_ids" nolabel="1" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="name"/>
                                <field name="description"/>
                            </list>
                        </field>
                    </group>

                    <!-- KRA Lines -->
                    <notebook>
                        <page string="KRA &amp; Self Assessment" name="kra_lines">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="sequence" widget="handle"/>
                                    <field name="job_responsibility" readonly="1" string="KRA / Responsibility" class="text-wrap"/>
                                    <field name="deliverable" readonly="1" class="text-wrap"/>

                                    <!-- Employee fills self rating/comments (only in draft) -->
                                    <field name="self_rating_id"
                                           readonly="parent.state != 'draft' or not parent.is_own_record"/>
                                    <field name="self_comments"
                                           readonly="parent.state != 'draft' or not parent.is_own_record"
                                           optional="hide"/>

                                    <!-- Manager fills (only in submitted state) -->
                                    <field name="manager_rating_id"
                                           readonly="parent.state != 'submitted' or not parent.can_manager_approve"
                                           optional="show"/>
                                                    <field name="manager_comments"
                                           readonly="parent.state != 'submitted' or not parent.can_manager_approve"
                                           optional="hide"/>

                                    <!-- 2nd approver fills (only in manager_review) -->
                                    <field name="second_rating_id"
                                           readonly="parent.state != 'manager_review' or not parent.can_second_approve"
                                           optional="show"/>
                                                    <field name="second_comments"
                                           readonly="parent.state != 'manager_review' or not parent.can_second_approve"
                                           optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Work Attitude &amp; Behavior" name="attitude_lines">
                            <field name="attitude_line_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" readonly="1" class="text-wrap"/>
                                    <field name="description" readonly="1" class="text-wrap"/>

                                    <!-- Employee fills self rating/comments (only in draft) -->
                                    <field name="self_rating_id"
                                           readonly="parent.state != 'draft' or not parent.is_own_record"/>
                                                    <field name="self_comments"
                                           readonly="parent.state != 'draft' or not parent.is_own_record"
                                           optional="hide"/>

                                    <!-- Manager fills (only in submitted state) -->
                                    <field name="manager_rating_id"
                                           readonly="parent.state != 'submitted' or not parent.can_manager_approve"
                                           optional="show"/>
                                                    <field name="manager_comments"
                                           readonly="parent.state != 'submitted' or not parent.can_manager_approve"
                                           optional="hide"/>

                                    <!-- 2nd approver fills (only in manager_review) -->
                                    <field name="second_rating_id"
                                           readonly="parent.state != 'manager_review' or not parent.can_second_approve"
                                           optional="show"/>
                                                    <field name="second_comments"
                                           readonly="parent.state != 'manager_review' or not parent.can_second_approve"
                                           optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Mistakes, Complaints, and Incidents" name="incident_lines">
                            <field name="incident_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="description"/>
                                    <field name="impact"/>
                                    <field name="action_taken"/>
                                </list>
                            </field>
                            <group>
                                <field name="additional_tasks_initiatives"/>
                            </group>
                        </page>

                        <page string="Training" name="training_lines">
                            <field name="training_line_ids" nolabel="1">
                                <list editable="bottom" delete="false">
                                    <field name="sequence" widget="handle"
                                           readonly="parent.state != 'draft' or not parent.is_own_record"/>
                                    <field name="training" readonly="1"/>
                                    <field name="want_to_learn"
                                           readonly="parent.state != 'draft' or not parent.is_own_record"/>
                                    <field name="have_complete_knowledge"
                                           readonly="parent.state != 'draft' or not parent.is_own_record"/>
                                    <field name="want_to_become_trainer"
                                           readonly="parent.state != 'draft' or not parent.is_own_record"/>
                                </list>
                            </field>
                            <group>
                                <field name="training_comments"
                                       readonly="state != 'draft' or not is_own_record"/>
                            </group>
                        </page>

                        <page string="Overall Comments" name="overall_comments">
                            <group>
                                <field name="overall_self_comments"
                                       readonly="state != 'draft' or not is_own_record"
                                       required="state == 'draft'"/>
                                <field name="overall_manager_comments"
                                       readonly="state != 'submitted' or not can_manager_approve"
                                       required="state == 'submitted'"/>
                                <field name="overall_second_comments"
                                       readonly="state != 'manager_review' or not can_second_approve"
                                       required="state == 'manager_review'"/>
                            </group>
                            <group string="Comments and Suggestions">
                                <field name="general_comments" nolabel="1"/>
                            </group>
                            <group string="Sign-off">
                                <field name="employee_signature" widget="signature"
                                       options="{'full_name': 'employee_id'}"
                                       string="Employee Signature"
                                       readonly="state != 'draft' or not is_own_record"/>
                                <field name="manager_signature" widget="signature"
                                       options="{'full_name': 'manager_id'}"
                                       string="Manager's Signature"
                                       readonly="state != 'submitted' or not can_manager_approve"/>
                                <field name="owner_signature" widget="signature"
                                       options="{'full_name': 'second_manager_id'}"
                                       string="Owner's Signature"
                                       readonly="state != 'manager_review' or not can_second_approve"/>
                            </group>
                        </page>
                    </notebook>

                    <!-- Cancel reason (shown only when rejected/cancelled) -->
                    <group invisible="state not in ['rejected','cancelled']">
                        <field name="cancel_reason" readonly="1"/>
                    </group>

                    <!-- Invisible helper fields -->
                    <field name="can_submit" invisible="1"/>
                    <field name="can_manager_approve" invisible="1"/>
                    <field name="can_second_approve" invisible="1"/>
                    <field name="can_reject" invisible="1"/>
                    <field name="is_own_record" invisible="1"/>
                    <field name="employee_user_id" invisible="1"/>
                    <field name="manager_user_id" invisible="1"/>
                    <field name="second_manager_user_id" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════
         LIST VIEW
    ══════════════════════════════════════════ -->
    <record id="pms_appraisal_view_list" model="ir.ui.view">
        <field name="name">pms.appraisal.list</field>
        <field name="model">pms.appraisal</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'"
                  decoration-warning="state in ('submitted','manager_review','second_review')"
                  decoration-danger="state in ('rejected','cancelled')"
                  decoration-muted="state == 'cancelled'">
                <header>
                    <button name="action_export_xlsx_report"
                            type="object"
                            string="Export Excel Report"
                            class="btn-secondary"/>
                </header>
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id"/>
                <field name="financial_year_id"/>
                <field name="kra_id"/>
                <field name="attitude_id"/>
                <field name="manager_id"/>
                <field name="submit_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state in ('submitted','manager_review','second_review')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════
         SEARCH VIEW
    ══════════════════════════════════════════ -->
    <record id="pms_appraisal_view_search" model="ir.ui.view">
        <field name="name">pms.appraisal.search</field>
        <field name="model">pms.appraisal</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="financial_year_id"/>
                <field name="kra_id"/>
                <field name="attitude_id"/>
                <field name="department_id"/>
                <!-- Quick filters -->
                <filter string="My PMS" name="my_pms"
                        domain="[('employee_user_id','=',uid)]"/>
                <filter string="My Team" name="my_team"
                        domain="[('manager_user_id','=',uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Manager Review" name="manager_review"
                        domain="[('state','=','manager_review')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter string="Pending My Action" name="pending_my_action"
                        domain="['|','|',
                            '&amp;',('state','=','draft'),('employee_user_id','=',uid),
                            '&amp;',('state','=','submitted'),('manager_user_id','=',uid),
                            '&amp;',('state','=','manager_review'),('second_manager_user_id','=',uid)
                        ]"/>
                <group>
                    <filter string="Financial Year" name="group_fy"
                            context="{'group_by':'financial_year_id'}"/>
                    <filter string="Department" name="group_dept"
                            context="{'group_by':'department_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════
         ACTIONS
    ══════════════════════════════════════════ -->

    <!-- All PMS — Head sees all -->
    <record id="action_pms_appraisal_all" model="ir.actions.act_window">
        <field name="name">All PMS Records</field>
        <field name="res_model">pms.appraisal</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pms_appraisal_view_search"/>
    </record>

    <!-- My PMS — Employee sees own -->
    <record id="action_pms_appraisal_my" model="ir.actions.act_window">
        <field name="name">My PMS</field>
        <field name="res_model">pms.appraisal</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_user_id','=',uid)]</field>
        <field name="search_view_id" ref="pms_appraisal_view_search"/>
        <field name="context">{'search_default_my_pms': 1}</field>
    </record>

    <!-- Team PMS — Manager sees team -->
    <record id="action_pms_appraisal_team" model="ir.actions.act_window">
        <field name="name">Team PMS</field>
        <field name="res_model">pms.appraisal</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|','|',
            ('manager_user_id','=',uid),
            ('second_manager_user_id','=',uid),
            ('employee_id.parent_id.user_id','=',uid)
        ]</field>
        <field name="search_view_id" ref="pms_appraisal_view_search"/>
    </record>
</odoo>
