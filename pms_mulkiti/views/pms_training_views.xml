<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pms_training_view_form" model="ir.ui.view">
        <field name="name">pms.training.form</field>
        <field name="model">pms.training</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Training Name"/></h1>
                    </div>
                    <group>
                        <field name="financial_year_id"/>
                    </group>
                    <notebook>
                        <page string="Projects" name="training_lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pms_training_view_list" model="ir.ui.view">
        <field name="name">pms.training.list</field>
        <field name="model">pms.training</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="financial_year_id"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="pms_training_view_search" model="ir.ui.view">
        <field name="name">pms.training.search</field>
        <field name="model">pms.training</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="financial_year_id"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Financial Year" name="group_fy" context="{'group_by':'financial_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pms_training" model="ir.actions.act_window">
        <field name="name">Training Master</field>
        <field name="res_model">pms.training</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
