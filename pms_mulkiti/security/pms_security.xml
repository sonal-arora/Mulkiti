<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Privilege (replaces category_id in Odoo 19) ────────── -->
    <record model="res.groups.privilege" id="privilege_pms">
        <field name="name">Performance Management</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- ── Groups ─────────────────────────────────────────────── -->
    <record id="group_pms_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_pms"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Employee: can view and fill own PMS self-assessment.</field>
    </record>

    <record id="group_pms_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_pms"/>
        <field name="implied_ids" eval="[(4, ref('pms_mulkiti.group_pms_user'))]"/>
        <field name="comment">Manager: can view team PMS and give manager rating.</field>
    </record>

    <record id="group_pms_head" model="res.groups">
        <field name="name">Head</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_pms"/>
        <field name="implied_ids" eval="[(4, ref('pms_mulkiti.group_pms_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">PMS Head: full access — configure, initialize, and approve all PMS records.</field>
    </record>

    <!-- ── Record Rules ──────────────────────────────────────────
         User: sees only own appraisal
         Manager: sees own + team (where they are manager/2nd approver)
         Head: sees all
    ─────────────────────────────────────────────────────────── -->

    <data noupdate="1">
        <!-- User: only own appraisal -->
        <record id="pms_appraisal_rule_user" model="ir.rule">
            <field name="name">PMS Appraisal - User sees own</field>
            <field name="model_id" ref="pms_mulkiti.model_pms_appraisal"/>
            <field name="domain_force">[('employee_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('pms_mulkiti.group_pms_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager: own + team -->
        <record id="pms_appraisal_rule_manager" model="ir.rule">
            <field name="name">PMS Appraisal - Manager sees team</field>
            <field name="model_id" ref="pms_mulkiti.model_pms_appraisal"/>
            <field name="domain_force">['|','|','|',
                ('employee_user_id', '=', user.id),
                ('manager_user_id', '=', user.id),
                ('second_manager_user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('pms_mulkiti.group_pms_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Head: full access -->
        <record id="pms_appraisal_rule_head" model="ir.rule">
            <field name="name">PMS Appraisal - Head sees all</field>
            <field name="model_id" ref="pms_mulkiti.model_pms_appraisal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('pms_mulkiti.group_pms_head'))]"/>
        </record>
    </data>
</odoo>
