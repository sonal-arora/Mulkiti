<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_task_main_category_list" model="ir.ui.view">
        <field name="name">project.task.main.category.list</field>
        <field name="model">project.task.main.category</field>
        <field name="arch" type="xml">
            <list string="Main Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="sub_category_count" string="Sub Categories"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_project_task_main_category_form" model="ir.ui.view">
        <field name="name">project.task.main.category.form</field>
        <field name="model">project.task.main.category</field>
        <field name="arch" type="xml">
            <form string="Main Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_project_task_sub_category)d" type="action"
                                class="oe_stat_button" icon="fa-list"
                                context="{'search_default_main_category_id': id}">
                            <field name="sub_category_count" widget="statinfo" string="Sub Categories"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Sub Categories" name="sub_categories">
                            <field name="sub_category_ids" context="{'default_main_category_id': id}">
                                <list string="Sub Categories" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="default_priority_id"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_task_main_category" model="ir.actions.act_window">
        <field name="name">Main Categories</field>
        <field name="res_model">project.task.main.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
