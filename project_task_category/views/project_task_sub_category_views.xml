<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_task_sub_category_list" model="ir.ui.view">
        <field name="name">project.task.sub.category.list</field>
        <field name="model">project.task.sub.category</field>
        <field name="arch" type="xml">
            <list string="Sub Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="main_category_id"/>
                <field name="default_priority_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_project_task_sub_category_form" model="ir.ui.view">
        <field name="name">project.task.sub.category.form</field>
        <field name="model">project.task.sub.category</field>
        <field name="arch" type="xml">
            <form string="Sub Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="main_category_id"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="default_priority_id"/>
                            <field name="working_hours"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_task_sub_category_search" model="ir.ui.view">
        <field name="name">project.task.sub.category.search</field>
        <field name="model">project.task.sub.category</field>
        <field name="arch" type="xml">
            <search string="Sub Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="main_category_id"/>
                <field name="default_priority_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="groupby_main_category" string="Main Category" context="{'group_by': 'main_category_id'}"/>
                    <filter name="groupby_default_priority" string="Default Priority" context="{'group_by': 'default_priority_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_project_task_sub_category" model="ir.actions.act_window">
        <field name="name">Sub Categories</field>
        <field name="res_model">project.task.sub.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_task_sub_category_search"/>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
