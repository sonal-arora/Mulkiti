<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_project_task_code" model="ir.sequence">
            <field name="name">Task ID Sequence</field>
            <field name="code">project.task.code.seq</field>
            <field name="prefix">MTSK/%(month)s/%(year)s/</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
