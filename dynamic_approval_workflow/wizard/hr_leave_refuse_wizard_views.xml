<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_refuse_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.leave.refuse.wizard.form</field>
        <field name="model">hr.leave.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuse Leave Request">
                <div class="o_dialog_warning alert alert-warning" role="alert">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    Please provide a reason for refusing this leave request.
                </div>
                <group>
                    <field name="leave_ids" invisible="1"/>
                    <field name="reason"
                           string="Reason"
                           placeholder="Enter reason for refusal..."
                           nolabel="1"
                           required="1"
                           widget="text"/>
                </group>
                <footer>
                    <button string="Refuse"
                            name="action_refuse"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
