<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!--
        Record rules so that custom approvers (1st / 2nd) can view and
        write leave records of employees they are assigned to, WITHOUT
        needing Time Off Officer rights.

        Odoo combines same-group rules with OR, so these rules EXPAND
        access, never restrict it.
    -->

    <!-- Approver can READ leaves where they are 1st or 2nd approver -->
    <record id="hr_leave_rule_custom_approver_read" model="ir.rule">
        <field name="name">Leave: Custom Approver — Read</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">
            ['|',
                ('employee_id.x_leave_approver_1_id',  '=', user.id),
                ('employee_id.x_leave_approver_2_id', '=', user.id),
            ]
        </field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Approver can WRITE (approve/refuse) leaves they are assigned to -->
    <record id="hr_leave_rule_custom_approver_write" model="ir.rule">
        <field name="name">Leave: Custom Approver — Write</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">
            ['|',
                ('employee_id.x_leave_approver_1_id',  '=', user.id),
                ('employee_id.x_leave_approver_2_id', '=', user.id),
            ]
        </field>
        <field name="perm_read"   eval="False"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Direct manager (parent_id) can READ leaves of their direct reports -->
    <record id="hr_leave_rule_manager_read" model="ir.rule">
        <field name="name">Leave: Direct Manager — Read</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">
            [('employee_id.parent_id.user_id', '=', user.id)]
        </field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Direct manager can WRITE (approve/refuse) their direct reports' leaves -->
    <record id="hr_leave_rule_manager_write" model="ir.rule">
        <field name="name">Leave: Direct Manager — Write</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">
            [('employee_id.parent_id.user_id', '=', user.id)]
        </field>
        <field name="perm_read"   eval="False"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Indirect manager (2 levels up) can READ leaves of indirect reports
         e.g. Rohit → Ramnath → Maricor: Rohit can see Maricor's leaves -->
    <record id="hr_leave_rule_indirect_manager_read" model="ir.rule">
        <field name="name">Leave: Indirect Manager — Read</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">
            [('employee_id.parent_id.parent_id.user_id', '=', user.id)]
        </field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Indirect manager can see indirect reports in org chart (hr.employee.public) -->
    <record id="hr_employee_public_indirect_manager_rule" model="ir.rule">
        <field name="name">Employee Public: Indirect Manager — Read</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="domain_force">
            [('parent_id.parent_id.user_id', '=', user.id)]
        </field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ─── Leave Summary record rules ───────────────────────────────────────
         base.group_user (approvers) see ONLY employees they approve for.
         Officers/Managers already have full access via ir.model.access so
         no separate "see all" rule needed for them.
    ──────────────────────────────────────────────────────────────────────── -->

    <!-- 1st/2nd approver, direct manager & indirect manager: see their reportees -->
    <record id="hr_leave_summary_rule_approver" model="ir.rule">
        <field name="name">Leave Summary: Approver sees own reportees only</field>
        <field name="model_id" ref="model_hr_leave_summary"/>
        <field name="domain_force">
            ['|', '|', '|',
                ('employee_id.x_leave_approver_1_id',          '=', user.id),
                ('employee_id.x_leave_approver_2_id',          '=', user.id),
                ('employee_id.parent_id.user_id',              '=', user.id),
                ('employee_id.parent_id.parent_id.user_id',    '=', user.id),
            ]
        </field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Time Off Officers see ALL employees in leave summary -->
    <record id="hr_leave_summary_rule_officer" model="ir.rule">
        <field name="name">Leave Summary: Officer sees all</field>
        <field name="model_id" ref="model_hr_leave_summary"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
    </record>

</data>
</odoo>
