<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        "Brickwork Leaves" section on the user form (Settings > Users):
        View Only = read-only access to the leaves of every employee whose
        tags include the Brickwork tag (hr.employee.category.is_brickwork).
    -->
    <record id="res_groups_privilege_brickwork_leave" model="res.groups.privilege">
        <field name="name">Brickwork Leaves</field>
        <field name="sequence">11</field>
        <field name="placeholder">No</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_brickwork_leave_viewer" model="res.groups">
        <field name="name">View Only</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_brickwork_leave"/>
        <field name="comment">Read-only access to the time off of employees tagged as Brickwork.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!--
        Read only: write/create/unlink stay governed by the existing
        base.group_user rules (own leaves, direct reports, custom approvers).
        Rules of the same operation are OR-ed, so this only adds visibility.
    -->
    <record id="hr_leave_rule_brickwork_viewer" model="ir.rule">
        <field name="name">Leave: Brickwork Viewer — Read</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('employee_id.category_ids.is_brickwork', '=', True)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('group_brickwork_leave_viewer'))]"/>
    </record>

    <!-- Lets the viewer read the Employee shown on those leaves. -->
    <record id="hr_employee_public_rule_brickwork_viewer" model="ir.rule">
        <field name="name">Employee Public: Brickwork Viewer — Read</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="domain_force">[('employee_id.category_ids.is_brickwork', '=', True)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('group_brickwork_leave_viewer'))]"/>
    </record>
</odoo>
