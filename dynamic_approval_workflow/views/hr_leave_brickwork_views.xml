<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Read-only list of Brickwork employees' leaves for the
        "Brickwork Leaves / View Only" group. create/edit/delete are
        switched off in the UI; the record rule is read-only as well.
    -->
    <record id="hr_leave_action_brickwork" model="ir.actions.act_window">
        <field name="name">Brickwork Leaves</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_brickwork_employee', '=', True)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'duplicate': False}</field>
        <field name="search_view_id" ref="hr_leave_view_search_approver"/>
        <field name="views" eval="[
            (ref('hr_holidays.hr_leave_view_tree'), 'list'),
            (ref('hr_holidays.hr_leave_view_form'), 'form'),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No leaves found for Brickwork employees.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_hr_leave_brickwork"
        name="Brickwork Leaves"
        action="hr_leave_action_brickwork"
        sequence="226"
        web_icon="hr_holidays,static/description/icon.png"
        groups="group_brickwork_leave_viewer"
    />
</odoo>
