<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         LEAVE REQUEST FORM VIEW
    ══════════════════════════════════════════════════════════════════ -->
    <record id="hr_leave_view_form_multi_approval" model="ir.ui.view">
        <field name="name">hr.leave.view.form.multi.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <!-- 1. Inject helper fields -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="can_validate2" invisible="1"/>
                <field name="has_second_approver" invisible="1"/>
            </xpath>

            <!-- 2. Add "Second Approve" button before the Refuse button -->
            <xpath expr="//button[@name='action_refuse']" position="before">
                <button
                    name="action_second_approve"
                    type="object"
                    string="Second Approve"
                    class="oe_highlight"
                    invisible="not can_validate2 or not id"
                />
            </xpath>

            <!-- 3. Replace both status-bar fields with conditional bars -->
            <xpath expr="//field[@name='state'][@statusbar_visible='confirm,validate,validate1']" position="replace">
                <!-- With 2nd approver: confirm → validate1 → validate2 (HR) → validate -->
                <field name="state" widget="statusbar"
                       statusbar_visible="confirm,validate1,validate2,validate"
                       invisible="validation_type != 'both' or not has_second_approver"/>
                <!-- Without 2nd approver: confirm → validate2 (HR) → validate -->
                <field name="state" widget="statusbar"
                       statusbar_visible="confirm,validate2,validate"
                       invisible="validation_type != 'both' or has_second_approver"/>
            </xpath>
            <xpath expr="//field[@name='state'][@statusbar_visible='confirm,validate']" position="replace">
                <field name="state" widget="statusbar"
                       statusbar_visible="confirm,validate1,validate2,validate"
                       invisible="validation_type == 'both' or not has_second_approver"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="confirm,validate2,validate"
                       invisible="validation_type == 'both' or has_second_approver"/>
            </xpath>

            <!-- 4. Show approver names after the top-level invisible employee_id -->
            <xpath expr="//form/field[@name='employee_id']" position="after">
                <field name="x_leave_approver_1_id" readonly="1" string="1st Approver"
                       invisible="not x_leave_approver_1_id"/>
                <field name="x_leave_approver_2_id" readonly="1" string="2nd Approver"
                       invisible="not x_leave_approver_2_id"/>
            </xpath>

            <!-- 5. Show refuse reason on employee's own form when refused -->
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="refuse_reason"
                       string="Reason for Refusal"
                       widget="text"
                       readonly="1"
                       invisible="state != 'refuse'"/>
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         LEAVE KANBAN VIEW — fix ribbons for the custom validate1/validate2
         states. Base Odoo only knows confirm/validate1/validate/cancel/refuse,
         so cards at our new 'validate2' (HR Approval) state showed NO ribbon
         at all, and 'validate1' kept the generic base "To Validate" label
         even though our flow now calls it "Second Approval".
    ══════════════════════════════════════════════════════════════════ -->
    <record id="hr_leave_view_kanban_multi_approval" model="ir.ui.view">
        <field name="name">hr.leave.view.kanban.multi.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon'][2]" position="attributes">
                <attribute name="title">2nd Approval</attribute>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon'][2]" position="after">
                <widget name="web_ribbon" title="HR Approval" bg_color="text-bg-warning" invisible="state != 'validate2'"/>
            </xpath>

            <!-- Fetch can_validate2 so kanban templates can read it -->
            <xpath expr="//field[@name='can_refuse']" position="after">
                <field name="can_validate2"/>
            </xpath>

            <!-- Force the action-button row to stay on a single line instead of
                 wrapping "2nd Approve" above "Refuse". Tighter gap/padding frees
                 up the extra width the smaller buttons need. -->
            <xpath expr="//div[hasclass('o_hr_holidays_button')]" position="attributes">
                <attribute name="class" add="flex-nowrap align-items-center" remove="flex-wrap pe-4 gap-2" separator=" "/>
                <attribute name="class" add="pe-1 gap-1" separator=" "/>
            </xpath>

            <!-- Shrink Refuse to match the smaller "2nd Approve" button so both
                 sit at the same height on the same row. -->
            <xpath expr="//div[hasclass('o_hr_holidays_button')]/button[@name='action_refuse']" position="attributes">
                <attribute name="class" add="btn-sm" separator=" "/>
            </xpath>

            <!-- Desktop card: Second Approve button, before Refuse.
                 btn-sm keeps it the same height as Refuse so the row stays on
                 one line instead of wrapping under the top-right ribbon. -->
            <xpath expr="//div[hasclass('o_hr_holidays_button')]/button[@name='action_refuse']" position="before">
                <button
                    name="action_second_approve" type="object" class="btn btn-sm btn-primary text-nowrap"
                    t-if="record.can_validate2.raw_value">
                    2nd Approve
                </button>
            </xpath>

            <!-- Mobile card: Second Approve button, before Refuse -->
            <xpath expr="//bottom/button[@name='action_refuse']" position="before">
                <button t-if="record.can_validate2.raw_value" name="action_second_approve" type="object" class="btn btn-sm btn-primary py-0"
                    groups="hr_holidays.group_hr_holidays_user">
                    2nd Approve
                </button>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         LEAVE LIST VIEW — optional approver columns
    ══════════════════════════════════════════════════════════════════ -->
    <record id="hr_leave_view_list_multi_approval" model="ir.ui.view">
        <field name="name">hr.leave.view.list.multi.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="x_leave_approver_1_id" optional="hide" string="1st Approver"/>
                <field name="x_leave_approver_2_id" optional="hide" string="2nd Approver"/>
            </xpath>

            <!-- Header: bulk "Second Approve" action for selected rows -->
            <xpath expr="//list/header/button[@name='action_refuse']" position="before">
                <button type="object"
                    name="action_second_approve"
                    string="Second Approve"
                    icon="fa-thumbs-up"
                    class="btn btn-outline-success"
                />
            </xpath>

            <!-- Row-level: "Second Approve" button, before Refuse -->
            <xpath expr="//list/button[@name='action_refuse'][@invisible='not can_refuse']" position="before">
                <button string="Second Approve" name="action_second_approve" type="object"
                    icon="fa-thumbs-up"
                    invisible="not can_validate2"/>
            </xpath>
        </field>
    </record>


    <!-- ══════════════════════════════════════════════════════════════════
         ALLOCATION LIST VIEW — rename "Amount" column header to "Days"
    ══════════════════════════════════════════════════════════════════ -->
    <record id="hr_leave_allocation_view_list_days_label" model="ir.ui.view">
        <field name="name">hr.leave.allocation.view.list.days.label</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration_display']" position="attributes">
                <attribute name="string">Days</attribute>
            </xpath>
        </field>
    </record>

</odoo>
