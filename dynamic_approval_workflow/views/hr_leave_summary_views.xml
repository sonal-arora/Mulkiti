<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         LIST VIEW — Leave Summary (read-only)
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="hr_leave_summary_view_list" model="ir.ui.view">
        <field name="name">hr.leave.summary.list</field>
        <field name="model">hr.leave.summary</field>
        <field name="arch" type="xml">
            <list string="Leave Summary"
                  create="0"
                  edit="0"
                  delete="0"
                  decoration-danger="balance &lt;= 0 and total_allocated &gt; 0"
                  decoration-warning="pending_approval &gt; 0">

                <field name="employee_id"
                       string="Employee"
                       widget="many2one_avatar_employee"
                       readonly="1"/>
                <field name="department_id"
                       string="Department"
                       optional="show"
                       readonly="1"/>
                <field name="holiday_status_id"
                       string="Leave Type"
                       readonly="1"/>
                <field name="total_allocated"
                       string="Allocated (Days)"
                       readonly="1"/>
                <field name="leaves_taken"
                       string="Used (Days)"
                       readonly="1"/>
                <field name="pending_approval"
                       string="Pending Approval"
                       readonly="1"/>
                <field name="balance"
                       string="Balance (Days)"
                       readonly="1"
                       decoration-danger="balance &lt;= 0"
                       decoration-success="balance &gt; 0"/>
                <field name="negative_leaves"
                       string="Negative Leaves"
                       readonly="1"
                       optional="show"
                       decoration-danger="negative_leaves &gt; 0"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         SEARCH VIEW
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="hr_leave_summary_view_search" model="ir.ui.view">
        <field name="name">hr.leave.summary.search</field>
        <field name="model">hr.leave.summary</field>
        <field name="arch" type="xml">
            <search string="Search Leave Summary">
                <field name="employee_id" string="Employee"/>
                <field name="department_id" string="Department"/>
                <field name="holiday_status_id" string="Leave Type"/>
                <filter string="Has Pending Approval"
                        name="has_pending"
                        domain="[('pending_approval', '>', 0)]"/>
                <filter string="Balance Exhausted"
                        name="exhausted"
                        domain="[('balance', '=', 0)]"/>
                <filter string="Has Balance"
                        name="has_balance"
                        domain="[('balance', '>', 0)]"/>
                <filter string="Has Negative Leaves"
                        name="has_negative"
                        domain="[('negative_leaves', '&lt;', 0)]"/>
                <filter string="Group by Employee"
                        name="group_employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter string="Group by Department"
                        name="group_department"
                        context="{'group_by': 'department_id'}"/>
                <filter string="Group by Leave Type"
                        name="group_leave_type"
                        context="{'group_by': 'holiday_status_id'}"/>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         WINDOW ACTION
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="action_hr_leave_summary" model="ir.actions.act_window">
        <field name="name">Leave Summary</field>
        <field name="res_model">hr.leave.summary</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="hr_leave_summary_view_list"/>
        <field name="search_view_id" ref="hr_leave_summary_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No leave data found.
            </p>
            <p>
                Leave summary shows allocated, used, pending and balance
                days per employee per leave type.
            </p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         MENU — under Management, visible to Time Off Officer (sees all)
    ══════════════════════════════════════════════════════════════════════ -->
    <menuitem
        id="menu_hr_leave_summary"
        name="Leave Summary"
        parent="hr_holidays.menu_hr_holidays_management"
        action="action_hr_leave_summary"
        sequence="20"
        groups="hr_holidays.group_hr_holidays_user"/>

    <!-- ══════════════════════════════════════════════════════════════════════
         MENU — under Team Approvals tab, visible to 1st/2nd approvers
         (record rule filters to only their reportees)
    ══════════════════════════════════════════════════════════════════════ -->
    <menuitem
        id="menu_hr_leave_summary_approver"
        name="Team Leave Summary"
        parent="dynamic_approval_workflow.menu_hr_leave_team_approvals"
        action="action_hr_leave_summary"
        sequence="3"
        groups="base.group_user"/>

</odoo>
