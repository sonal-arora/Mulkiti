<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited the hr_payslip form view to add 'loan_line_id' field within the 'input_line_ids' tree. -->
    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.inherit.ohrms.loan</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_view_form"/>
        <field name="arch" type="xml">
           <field name="input_line_ids">
                <list>
                    <field name="loan_line_id" column_invisible="True" optional="hide"/>
                </list>
            </field>
        </field>
    </record>
</odoo>
