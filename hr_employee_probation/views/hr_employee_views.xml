<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         EMPLOYEE FORM - PROBATION WORKFLOW
    ════════════════════════════════════════════════════════ -->
    <record id="hr_employee_view_form_probation" model="ir.ui.view">
        <field name="name">hr.employee.form.probation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Header: "Confirm as Regular" button + status pipeline -->
            <xpath expr="//header" position="inside">
                <button name="action_confirm_employee"
                        type="object"
                        string="Confirm as Regular"
                        class="btn-primary"
                        groups="hr.group_hr_user"
                        invisible="employment_status == 'confirmed'"
                        confirm="Confirm this employee as Regular? This will end their probation period."/>
                <field name="employment_status" widget="statusbar"
                       statusbar_visible="probation,confirmed"/>
            </xpath>

            <!-- Warning banner once probation has ended but is not yet confirmed -->
            <xpath expr="//div[contains(@class, 'oe_title')]" position="after">
                <field name="probation_completed" invisible="1"/>
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not probation_completed">
                    <strong>Probation period has ended.</strong>
                    Please confirm this employee as Regular or update the probation end date.
                </div>
            </xpath>

            <!-- Probation dates, next to the Manager field -->
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="probation_end_date"/>
                <field name="confirmation_date"
                       invisible="employment_status != 'confirmed'"
                       readonly="1"/>
            </xpath>

        </field>
    </record>

</odoo>
