<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         MY PAYSLIPS — Employee Self-Service (Read-Only, List Only)
         • Only PAID payslips
         • No header buttons
         • No form view on row click
         • Print button on every row
    ══════════════════════════════════════════════════════════════════ -->

    <record id="view_hr_payslip_tree_employee" model="ir.ui.view">
        <field name="name">hr.payslip.list.employee</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <list string="My Payslips"
                  create="0"
                  edit="0"
                  delete="0"
                  open_form_view="0"
                  multi_edit="0">

                <field name="name"       string="Payslip"      readonly="1"/>
                <field name="date_from"  string="From"         readonly="1"/>
                <field name="date_to"    string="To"           readonly="1"/>
                <field name="basic_wage" string="Basic Salary" readonly="1"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
<!--                <field name="gross_wage" string="Gross Salary" readonly="1"-->
<!--                       widget="monetary"-->
<!--                       options="{'currency_field': 'currency_id'}"/>-->
                <field name="net_wage"   string="Net Salary"   readonly="1"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       decoration-bf="1"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state"       column_invisible="True"/>

                <button string="Print"
                        name="action_print_payslip"
                        type="object"
                        icon="fa-print"
                        title="Download Payslip PDF"/>
            </list>
        </field>
    </record>

    <record id="action_my_payslips" model="ir.actions.act_window">
        <field name="name">My Payslips</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_hr_payslip_tree_employee"/>
        <field name="domain">[('employee_id.user_id', '=', uid), ('state', '=', 'paid')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No paid payslips yet.</p>
            <p>Your payslips will appear here once marked as paid by Payroll.</p>
        </field>
    </record>

</odoo>
