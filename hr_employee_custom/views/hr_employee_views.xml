<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         EMPLOYEE FORM VIEW INHERITANCE
    ════════════════════════════════════════════════════════ -->
    <record id="hr_employee_view_form_custom" model="ir.ui.view">
        <field name="name">hr.employee.form.custom</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file">
                    <field name="document_count" widget="statinfo"/>
                </button>
            </xpath>


            <!-- ── 3. ATTACHMENTS TAB - Visa, Passport, Emirates ID ─ -->
            <!-- Add after Private Information tab -->
            <xpath expr="//field[@name='has_work_permit']" position="attributes">
                <attribute name="string">Work permit</attribute>
            </xpath>


             <xpath expr="//label[@for='contract_date_start']" position="attributes">
                 <attribute name="string">Joining Date</attribute>
             </xpath>

            <xpath expr="//div[@name='contract_dates']" position="after">
                <field name="mol_contract_date"/>
            </xpath>

            <xpath expr="//field[@name='identification_id']" position="attributes">
                <attribute name="string">Emirates ID</attribute>
            </xpath>

           
            
            <xpath expr="//field[@name='wage']" position="attributes">
                <attribute name="string">Basic Salary</attribute>
            </xpath>

        </field>
    </record>


</odoo>
