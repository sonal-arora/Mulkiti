<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Override: hide ghost placeholder boxes when employee has no org chart hierarchy.
        Only the message is shown; the skeleton boxes are removed.
    -->
    <t t-name="hr_org_chart.hr_org_chart"
       t-inherit="hr_org_chart.hr_org_chart"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-if='!children.length &amp;&amp; !managers.length']" position="replace">
            <t t-if="!children.length &amp;&amp; !managers.length">
                <div class="text-center py-4">
                    <i class="fa fa-sitemap fa-2x text-muted mb-2 d-block"/>
                    <p class="text-muted fst-italic mb-0">No hierarchy defined for this employee.</p>
                </div>
            </t>
        </xpath>
    </t>

</templates>
