<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ── Privilege (required in Odoo 19 instead of category_id) ─────────── -->
    <record model="res.groups.privilege" id="res_groups_privilege_company_documents">
        <field name="name">Company Documents</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- ── Group ──────────────────────────────────────────────────────────── -->
    <record id="group_company_document_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_company_documents"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ── Record Rules ───────────────────────────────────────────────────── -->

    <!-- Managers see ALL documents -->
    <record id="rule_document_manager_all" model="ir.rule">
        <field name="name">Company Document: Manager sees all</field>
        <field name="model_id" ref="model_company_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('company_documents.group_company_document_manager'))]"/>
    </record>

    <!-- Regular employees see only PUBLIC documents of their company -->
    <record id="rule_document_employee_public" model="ir.rule">
        <field name="name">Company Document: Employee sees public only</field>
        <field name="model_id" ref="model_company_document"/>
        <field name="domain_force">[
            ('visibility', '=', 'public'),
            ('company_id', 'in', company_ids),
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</data>
</odoo>
