<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Document Published Notification -->
    <record id="email_template_document_notification" model="mail.template">
        <field name="name">Company Document: New Publication Notification</field>
        <field name="model_id" ref="model_company_document"/>
        <field name="subject">New Document Published: {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;">
    <div style="background:#875A7B;padding:25px;text-align:center;border-radius:8px 8px 0 0;">
        <h2 style="color:white;margin:0;">New Document Published</h2>
        <p style="color:#f0d9f0;margin:8px 0 0 0;font-size:14px;"><t t-out="object.company_id.name"/></p>
    </div>
    <div style="padding:30px;background:#fff;border:1px solid #e0e0e0;">
        <p style="margin:0 0 16px;">Dear <strong><t t-out="ctx.get('recipient_name', 'Team Member')"/></strong>,</p>
        <p style="color:#555;margin:0 0 20px;">A new document has been published for your reference:</p>
        <h3 style="color:#333;margin-top:0;"><t t-out="object.name"/></h3>
        <table style="width:100%;border-collapse:collapse;margin-bottom:20px;">
            <tr>
                <td style="padding:8px;color:#666;width:40%;"><strong>Category:</strong></td>
                <td style="padding:8px;color:#333;">
                    <t t-if="object.category_id"><t t-out="object.category_id.name"/></t>
                    <t t-else="">General</t>
                </td>
            </tr>
            <tr style="background:#f9f9f9;">
                <td style="padding:8px;color:#666;"><strong>Published:</strong></td>
                <td style="padding:8px;color:#333;"><t t-out="object.published_date"/></td>
            </tr>
        </table>
        <div style="text-align:center;margin-top:25px;">
            <a t-attf-href="#{ctx.get('base_url', '')}/odoo/company-documents"
               style="background:#875A7B;color:white;padding:13px 35px;text-decoration:none;border-radius:6px;font-weight:bold;">
                View Document
            </a>
        </div>
    </div>
    <div style="padding:15px;text-align:center;color:#aaa;font-size:12px;background:#f9f9f9;border-radius:0 0 8px 8px;">
        This is an automated notification. Please do not reply.
    </div>
</div>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Signature Request Email -->
    <record id="email_template_signature_request" model="mail.template">
        <field name="name">Company Document: Signature Request</field>
        <field name="model_id" ref="model_company_document_signature"/>
        <field name="subject">Action Required: Please Sign "{{ object.document_id.name }}"</field>
        <field name="email_from">{{ (object.document_id.company_id.email or user.email) }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;">
    <div style="background:#875A7B;padding:25px;text-align:center;border-radius:8px 8px 0 0;">
        <h2 style="color:white;margin:0;">Document Signature Required</h2>
        <p style="color:#f0d9f0;margin:8px 0 0 0;"><t t-out="object.document_id.company_id.name"/></p>
    </div>
    <div style="padding:30px;background:#fff;border:1px solid #e0e0e0;">
        <p style="color:#333;font-size:16px;">Dear <strong><t t-out="object.employee_id.name"/></strong>,</p>
        <p style="color:#555;">You have been requested to review and sign the following document:</p>
        <div style="background:#f5f0f7;border-left:4px solid #875A7B;padding:15px;margin:20px 0;border-radius:4px;">
            <h3 style="margin:0;color:#875A7B;"><t t-out="object.document_id.name"/></h3>
            <t t-if="object.document_id.category_id">
                <p style="margin:5px 0 0 0;color:#666;"><t t-out="object.document_id.category_id.name"/></p>
            </t>
        </div>
        <t t-if="ctx.get('wizard_message')">
            <div style="background:#fff8e1;border:1px solid #ffe082;padding:15px;border-radius:4px;margin-bottom:20px;">
                <p style="margin:0;color:#555;"><strong>Message:</strong> <t t-out="ctx.get('wizard_message')"/></p>
            </div>
        </t>
        <p style="color:#555;">Please click the button below to review and sign the document.</p>
        <div style="text-align:center;margin:30px 0;">
            <a t-att-href="object.sign_url"
               style="background:#875A7B;color:white;padding:15px 40px;text-decoration:none;
                      border-radius:6px;font-weight:bold;font-size:16px;display:inline-block;">
                Review &amp; Sign
            </a>
        </div>
        <p style="color:#999;font-size:12px;text-align:center;">
            This link is unique to you. Please do not share it with anyone.
        </p>
    </div>
    <div style="padding:15px;text-align:center;color:#aaa;font-size:12px;background:#f9f9f9;border-radius:0 0 8px 8px;">
        This is an automated message from <t t-out="object.document_id.company_id.name"/>.
    </div>
</div>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
