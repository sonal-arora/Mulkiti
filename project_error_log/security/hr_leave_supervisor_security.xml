<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Reuses the existing "Team Leave Summary" menu/screen
        (dynamic_approval_workflow, model hr.leave.summary) instead of
        separate menus - that menu is already visible to any base.group_user,
        which the Supervisor viewer group already is. By default
        base.group_user only sees their own reportees there
        (hr_leave_summary_rule_approver); this rule grants this specific
        group the same "see everyone [in their allowed companies]" access
        Time Off Officers already have, combined via OR with the existing
        rule - no menu changes needed.

        Scoped to company_ids (the logged-in user's currently allowed
        companies) via employee_id.company_id, since hr.leave.summary has no
        company_id field of its own - it is a plain reporting SQL view over
        hr.employee. Someone logged into Company A must not see Company B's
        records just because they hold this group.
    -->
    <record id="hr_leave_summary_rule_supervisor_viewer" model="ir.rule">
        <field name="name">Leave Summary: Supervisor viewer sees all (own company)</field>
        <field name="model_id" ref="dynamic_approval_workflow.model_hr_leave_summary"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('group_project_error_log_viewer'))]"/>
    </record>

    <!--
        Without this, the employee_id shown on each Leave Summary row would
        be unreadable for this group (base.group_user only sees employees
        via hr.employee.public, itself capped to reportees by other rules).
        Same company scoping as above.
    -->
    <record id="hr_employee_public_rule_supervisor_viewer" model="ir.rule">
        <field name="name">Employee Public: Supervisor viewer sees all (own company)</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('group_project_error_log_viewer'))]"/>
    </record>
</odoo>
