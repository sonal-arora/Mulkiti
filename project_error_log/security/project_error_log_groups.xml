<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        "Error Log" section on the user form (Settings > Users), with two
        dropdowns. A dropdown (privilege) holds a single group, so View Only
        has its own dropdown: it can be given alone or on top of User/Manager.
          - Error Log: User / Manager (Manager implies User).
          - View:      View Only (no effect on a Manager).
    -->
    <record id="module_category_error_log" model="ir.module.category">
        <field name="name">Error Log</field>
        <field name="sequence">95</field>
    </record>

    <record id="res_groups_privilege_error_log" model="res.groups.privilege">
        <field name="name">Error Log</field>
        <field name="sequence">1</field>
        <field name="placeholder">No access</field>
        <field name="category_id" ref="module_category_error_log"/>
    </record>

    <record id="res_groups_privilege_error_log_view" model="res.groups.privilege">
        <field name="name">View</field>
        <field name="sequence">2</field>
        <field name="placeholder">No</field>
        <field name="category_id" ref="module_category_error_log"/>
    </record>

    <record id="group_project_error_log_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_error_log"/>
        <field name="comment">Sees the Error Log menu and all entries, can create and edit them. Can be chosen as "Error Reported By" / "Error Made By".</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_project_error_log_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_error_log"/>
        <field name="comment">User rights, plus deleting entries and managing the Error Types.</field>
        <field name="implied_ids" eval="[(4, ref('group_project_error_log_user'))]"/>
    </record>

    <record id="group_project_error_log_viewer" model="res.groups">
        <field name="name">View Only</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_error_log_view"/>
        <field name="comment">Read-only. Alone: sees all Error Log entries. With User: read-only, and only the entries they reported, made, or created. With Manager: no effect (full Manager rights).</field>
    </record>

    <record id="group_hr_leave_summary_viewer" model="res.groups">
        <field name="name">Leave Summary - View Only</field>
        <field name="comment">Read-only, company-wide access to the Team Leave Summary (Time Off allocated/used/pending/balance per employee). Independent of Error Log access.</field>
    </record>

    <!--
        What a View Only member sees:
          - alone, or with Manager: everything.
          - with User: only the entries they reported, made, or created.
        Rules of different groups are OR-ed, but User/Manager have no rule on
        this model, so this one alone decides what a View Only member sees.
    -->
    <record id="project_error_log_rule_viewer" model="ir.rule">
        <field name="name">Error Log: View Only (own entries when also User)</field>
        <field name="model_id" ref="model_project_error_log"/>
        <field name="domain_force">['|', '|', ('reported_by_id', '=', user.id), ('made_by_id', '=', user.id), ('create_uid', '=', user.id)] if user.has_group('project_error_log.group_project_error_log_user') and not user.has_group('project_error_log.group_project_error_log_manager') else [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_project_error_log_viewer'))]"/>
    </record>
</odoo>
