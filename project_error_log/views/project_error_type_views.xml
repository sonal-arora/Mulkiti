<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_error_type_list" model="ir.ui.view">
        <field name="name">project.error.type.list</field>
        <field name="model">project.error.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
