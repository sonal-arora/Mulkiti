<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Single standalone entry point, NOT nested under project.menu_main_pm -
        Project's "Projects"/"Tasks" menu items have no group restriction of
        their own (Odoo relies on model-level access rights instead), so a
        view-only "Error Log" group member with no other Project rights would
        also see those if this were nested under the Project app.

        Visible to both:
          - project.group_project_user: full create/edit (see
            security/ir.model.access.csv - access_project_error_log_project_user).
          - group_project_error_log_viewer: read-only (see
            access_project_error_log_viewer). Someone with only this group
            gets a read-only menu; someone with both groups keeps full
            create/edit, since Odoo unions access rights across a user's
            groups.
    -->
    <menuitem
        id="menu_project_error_log_root"
        name="Error Log"
        groups="project.group_project_user,group_project_error_log_viewer"
        sequence="95"/>

    <menuitem
        id="menu_project_error_log"
        name="Error Log"
        parent="menu_project_error_log_root"
        action="action_project_error_log"
        groups="project.group_project_user,group_project_error_log_viewer"
        sequence="1"/>

    <menuitem
        id="menu_project_error_type"
        name="Error Types"
        parent="project.menu_project_config"
        action="action_project_error_type"
        groups="project.group_project_manager"
        sequence="44"/>
</odoo>
